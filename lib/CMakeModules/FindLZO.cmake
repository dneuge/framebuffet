SET(LZO_COPIED_DIR "${CMAKE_CURRENT_LIST_DIR}/../_build")

SET(LZO_INCLUDE_DIR "${LZO_COPIED_DIR}/")

IF(APPLE)
       SET(LZO_LIBRARIES "${LZO_COPIED_DIR}/liblzo2.dylib")
ELSEIF(UNIX)
       SET(LZO_LIBRARIES "${LZO_COPIED_DIR}/liblzo2.so")
ELSEIF(WIN32)
       IF(NOT CMAKE_GENERATOR MATCHES "Visual Studio")
              SET(LZO_LIBRARIES "${LZO_COPIED_DIR}/liblzo2.dll")
       #ELSE()
       #       SET(LZO_LIBRARIES "${LZO_COPIED_DIR}/lzo2_dllimport.lib")
       ENDIF()
ENDIF()

SET(LZO_FOUND TRUE)

INCLUDE(FindPackageHandleStandardArgs)
FIND_PACKAGE_HANDLE_STANDARD_ARGS(LZO DEFAULT_MSG LZO_INCLUDE_DIR LZO_LIBRARIES)
